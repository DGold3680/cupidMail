{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mymail-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],

  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  "vars": {
    "CLOUDINARY_CLOUD_NAME": "your-cloud-name"
  }
}
