# ==============================================================================
# Mymail - Serverless Multi-Domain Email Hosting Platform
# Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & SUPABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Get these from your Supabase Dashboard -> Project Settings -> Database
# Transaction pooler URL (recommended for serverless Next.js):
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL for Prisma migrations & schema pushes (port 5432):
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase API Credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# New Supabase Publishable Key (sb_publishable_...) or legacy anon key:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Or legacy: NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# New Supabase Secret Key (sb_secret_...) or legacy service_role key:
SUPABASE_SECRET_KEY="sb_secret_..."
# Or legacy: SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 2. CREDENTIAL ENCRYPTION (AES-256-GCM)
# ------------------------------------------------------------------------------
# A secure 32+ character random string used to encrypt users' Resend API keys at rest.
# Generate on Linux/Mac/Git Bash with: openssl rand -base64 32
APP_ENCRYPTION_SECRET="generate-a-random-32-byte-secret-key-here-12345"

# ------------------------------------------------------------------------------
# 3. CLOUDINARY STORAGE (Raw MIME & Attachments)
# ------------------------------------------------------------------------------
# Get these from Cloudinary Console -> Dashboard / Product Environment Settings
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ------------------------------------------------------------------------------
# 4. RESEND OUTGOING EMAIL (Optional global fallback)
# ------------------------------------------------------------------------------
# If not using BYOK in Settings -> Email Providers, this key will be used as fallback.
RESEND_API_KEY="re_123456789_abcdefg"

# ------------------------------------------------------------------------------
# 5. WORKER DIAGNOSTIC & ADMIN SECRET (Optional)
# ------------------------------------------------------------------------------
ADMIN_API_SECRET="admin-secret-for-worker-recovery"

